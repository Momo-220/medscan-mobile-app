<?xml version="1.0" encoding="utf-8"?>
<!-- Pill icon background: blue gradient rounded square -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#5B9FED"
        android:endColor="#3B7FD4"
        android:angle="135"
        android:type="linear" />
    <corners android:radius="14dp" />
    <stroke
        android:width="1dp"
        android:color="#FFFFFF"
        android:alpha="0.5" />
</shape>
